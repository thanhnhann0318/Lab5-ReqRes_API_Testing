        {
          "name": "POST - Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 429\", function () {\n    pm.expect(pm.response.code).to.be.oneOf([200, 429]);\n});\n\nconst response = pm.response.json();\n\npm.test(\"Response contains token if successful\", function () {\n    if (pm.response.code === 200) {\n        pm.expect(response.token).to.be.a(\"string\");\n    } else {\n        pm.expect(response.error).to.equal(\"rate_limit_exceeded\");\n    }\n});\n\nif (response.token) {\n    pm.environment.set(\"userToken\", response.token);\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"eve.holt@reqres.in\",\r\n  \"password\": \"pistol\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST - Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\nconst expectedName = pm.iterationData.get(\"name\");\r\nconst expectedJob = pm.iterationData.get(\"job\");\r\n\r\npm.test(\"Name matches CSV\", function () {\r\n    pm.expect(response.name).to.eql(expectedName);\r\n});\r\n\r\npm.test(\"Job matches CSV\", function () {\r\n    pm.expect(response.job).to.eql(expectedJob);\r\n});\r\n\r\npm.test(\"Response contains ID\", function () {\r\n    pm.expect(response.id).to.exist;\r\n});\r\n\r\nif (response.id !== undefined) {\r\n    pm.environment.set(\"userId\", String(response.id));\r\n}\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
